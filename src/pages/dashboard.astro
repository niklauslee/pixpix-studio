---
import App from "../apps/dashboard/app";
import Head from "../components/astro/head.astro";
import "../styles/global.css";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login");
}
---

<html lang="en">
  <Head title="Pixpix — Dashboard" />
  <body class="dark">
    <App client:only="react" user={{ name: user.name, image: user.image }} />
  </body>
</html>
